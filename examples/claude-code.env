# Point Claude Code at the router. This file ships with the package:
#   source "$(npm root -g)/@ediri/jev-router/examples/claude-code.env" && claude
# The CLI can do this for you: `jev-router setup` puts the same settings in ~/.claude/settings.json,
# `eval "$(jev-router env claude)"` exports them for one shell, and `jev-router launch claude` runs one
# session through the router (and starts a router if none runs).
export ANTHROPIC_BASE_URL=http://127.0.0.1:4000
# Label each request main/subagent/compaction/auxiliary (Claude Code 2.1.273+), so background calls
# and subagents never decide a session's tier.
export CLAUDE_CODE_GATEWAY_HINT_HEADERS=1
# Auth: keep your claude.ai login (the router passes it to Anthropic only), or give the router its own ANTHROPIC_API_KEY.
#
# Claude Code can't learn the routed model's context window through a gateway. Compact well before
# the smallest window among your tiers.
export CLAUDE_CODE_AUTO_COMPACT_WINDOW=160000
# Claude Code turns MCP tool search off behind a gateway and then sends every MCP tool's definition with
# every request. The router forwards tool search as is, so turn it back on.
export ENABLE_TOOL_SEARCH=true
# An output cap that `jev-router env claude` doesn't set. The router already lowers max_tokens to the
# limit of each Claude model it knows.
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=32000
# If the router runs with JEV_ROUTER_TOKEN, send it with every request:
# export ANTHROPIC_CUSTOM_HEADERS="x-jev-router-token: <token>"
# Start this shell's sessions on one tier instead of asking Jev (combine with the token line if both apply):
# export ANTHROPIC_CUSTOM_HEADERS="x-jev-tier: frontier"
